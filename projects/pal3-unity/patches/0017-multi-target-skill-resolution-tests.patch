+
+        private static CombatantState Caster()
+        {
+            return new CombatantState(maxHp: 100, attack: 20, defense: 10, maxMp: 50);
+        }
+
+        private static SkillDefinition CreateDamageSkill(
+            TargetRangeType targetRange,
+            int mpCost = 10,
+            int damage = 20,
+            int? damageValue = null)
+        {
+            int value = damageValue ?? -damage;
+            return new SkillDefinition(
+                id: 7001,
+                name: "Generic Multi Bolt",
+                type: SkillType.DamageMagic,
+                element: ElementType.Thunder,
+                targetRange,
+                mpCost,
+                spCost: 0,
+                visualArchetype: SkillVisualArchetype.AreaBurst,
+                visualProfileKey: "thunder.area.basic",
+                effects: new[]
+                {
+                    SkillEffectDefinition.ForAttribute(
+                        ActorAttributeType.Hp,
+                        AttributeImpactType.Absolute,
+                        value),
+                });
+        }
+
+        private static CombatTargetSlot<string> Enemy(
+            string key,
+            int row,
+            int column,
+            int hp = 100,
+            bool alive = true)
+        {
+            return Slot(key, CombatParty.Enemy, row, column, hp, alive);
+        }
+
+        private static CombatTargetSlot<string> Ally(
+            string key,
+            int row,
+            int column,
+            int hp = 100,
+            bool alive = true)
+        {
+            return Slot(key, CombatParty.First, row, column, hp, alive);
+        }
+
+        private static CombatTargetSlot<string> Slot(
+            string key,
+            CombatParty party,
+            int row,
+            int column,
+            int hp,
+            bool alive)
+        {
+            CombatantState state = new(maxHp: hp, attack: 10, defense: 5);
+            if (!alive)
+            {
+                Defeat(state);
+            }
+
+            return new CombatTargetSlot<string>(key, state, party, row, column);
+        }
+
+        private static CombatantState State(
+            CombatTargetSlot<string>[] slots,
+            string key)
+        {
+            return slots.Single(slot => slot.Key == key).State;
+        }
+
+        private static void Defeat(CombatantState state)
+        {
+            CombatantState killer = new(maxHp: 100, attack: 999, defense: 0);
+            NormalAttackResolver.Resolve(killer, state);
+        }
+    }
