+            Assert.That(State(slots, "r1c0").CurrentHp, Is.EqualTo(80));
+            Assert.That(State(slots, "r1c1").CurrentHp, Is.EqualTo(80));
+            Assert.That(State(slots, "r2c0").CurrentHp, Is.EqualTo(100));
+        }
