+namespace Pal3.Game.Tests.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Linq;
+    using NUnit.Framework;
+    using Pal3.Core.Contract.Enums;
+    using Pal3.Game.GameSystems.Combat.Domain;
+
+    public sealed class MultiTargetSkillResolverTests
+    {
+        [Test]
+        public void EnemyAll_SpendsMpOnceAndDamagesEveryLivingEnemy()
+        {
+            CombatantState caster = new(maxHp: 100, attack: 20, defense: 10, maxMp: 50);
+            CombatTargetSlot<string>[] slots =
+            {
+                Enemy("enemy-b", row: 1, column: 0, hp: 70),
+                Enemy("enemy-a", row: 0, column: 1, hp: 60),
+                Enemy("dead", row: 0, column: 0, hp: 40, alive: false),
+                Ally("ally", row: 0, column: 0, hp: 100),
+            };
+            SkillDefinition skill = CreateDamageSkill(
+                TargetRangeType.EnemyPartyAll,
+                mpCost: 12,
+                damage: 25);
+
+            MultiTargetSkillCastResolution<string> result =
+                MultiTargetSkillResolver<string>.Resolve(caster, slots, skill);
+
+            Assert.That(caster.CurrentMp, Is.EqualTo(38));
+            Assert.That(slots.Single(slot => slot.Key == "enemy-a").State.CurrentHp, Is.EqualTo(35));
+            Assert.That(slots.Single(slot => slot.Key == "enemy-b").State.CurrentHp, Is.EqualTo(45));
+            Assert.That(slots.Single(slot => slot.Key == "ally").State.CurrentHp, Is.EqualTo(100));
+            Assert.That(result.Targets.Select(target => target.TargetKey),
+                Is.EqualTo(new[] { "enemy-a", "enemy-b" }));
+        }
+
