+        [Test]
+        public void EachTarget_ClampsDamageAndEmitsIndependentDefeatFact()
+        {
+            CombatantState caster = Caster();
+            CombatTargetSlot<string>[] slots =
+            {
+                Enemy("fragile", row: 0, column: 0, hp: 10),
+                Enemy("sturdy", row: 0, column: 1, hp: 100),
+            };
+            SkillDefinition skill = CreateDamageSkill(
+                TargetRangeType.EnemyPartyAll,
+                damage: 30);
+
+            MultiTargetSkillCastResolution<string> result =
+                MultiTargetSkillResolver<string>.Resolve(caster, slots, skill);
+
+            TargetSkillResolution<string> fragile =
+                result.Targets.Single(target => target.TargetKey == "fragile");
+            TargetSkillResolution<string> sturdy =
+                result.Targets.Single(target => target.TargetKey == "sturdy");
+
+            Assert.That(fragile.Damage, Is.EqualTo(10));
+            Assert.That(fragile.IsTargetDefeated, Is.True);
+            Assert.That(fragile.Events.Select(entry => entry.Kind),
+                Is.EqualTo(new[] { CombatEventKind.Damage, CombatEventKind.TargetDefeated }));
+            Assert.That(sturdy.Damage, Is.EqualTo(30));
+            Assert.That(sturdy.IsTargetDefeated, Is.False);
+            Assert.That(sturdy.Events.Select(entry => entry.Kind),
+                Is.EqualTo(new[] { CombatEventKind.Damage }));
+        }
+
+        [Test]
+        public void Cast_EmitsExactlyOneSkillCastFactAndOneDamageFactPerTarget()
+        {
+            CombatantState caster = Caster();
+            CombatTargetSlot<string>[] slots =
+            {
+                Enemy("a", row: 0, column: 0),
+                Enemy("b", row: 0, column: 1),
+                Enemy("c", row: 1, column: 0),
+            };
+            SkillDefinition skill = CreateDamageSkill(TargetRangeType.EnemyPartyAll);
+
+            MultiTargetSkillCastResolution<string> result =
+                MultiTargetSkillResolver<string>.Resolve(caster, slots, skill);
+
+            Assert.That(result.CastEvents, Has.Count.EqualTo(1));
+            Assert.That(result.CastEvents[0].Kind, Is.EqualTo(CombatEventKind.SkillCast));
+            Assert.That(result.Targets, Has.Count.EqualTo(3));
+            Assert.That(result.Targets.SelectMany(target => target.Events)
+                .Count(entry => entry.Kind == CombatEventKind.Damage), Is.EqualTo(3));
+        }
