+        private static void ApplyCombatRewards(CombatResult combatResult)
+        {
+            if (!combatResult.IsPlayerWin) return;
+
+            CombatRewardSummary rewards = combatResult.Rewards;
+            if (rewards.Money > 0)
+            {
+                Pal3.Instance.Execute(new InventoryAddMoneyCommand(rewards.Money));
+            }
+
+            foreach ((uint itemId, int count) in rewards.Items)
+            {
+                Pal3.Instance.Execute(new InventoryAddItemCommand(checked((int)itemId), count));
+            }
+
+            if (rewards.Experience > 0)
+            {
+                EngineLogger.LogWarning(
+                    $"Combat EXP reward pending persistent actor-stat support: {rewards.Experience}");
+            }
+        }
