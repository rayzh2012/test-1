+namespace Pal3.PresentationSandbox.Tests.EditMode
+{
+    using System;
+    using System.IO;
+    using NUnit.Framework;
+    using global::Pal3.PresentationSandbox.Editor;
+    using UnityEngine;
+
+    public sealed class ProceduralProjectileSandboxCaptureTests
+    {
+        private static readonly string[] ExpectedPngFiles =
+        {
+            "00_baseline.png",
+            "01_cast.png",
+            "02_travel_00.png",
+            "03_travel_33.png",
+            "04_travel_66.png",
+            "05_travel_100.png",
+            "06_impact.png",
+        };
+
+        [Test]
+        public void Capture_WritesSevenValidPngFramesAndBoundaryManifest()
+        {
+            string projectRoot = Path.GetFullPath(Path.Combine(Application.dataPath, ".."));
+            string outputDirectory = Path.Combine(projectRoot, "out", "pal3-presentation-sandbox");
+
+            if (Directory.Exists(outputDirectory))
+            {
+                Directory.Delete(outputDirectory, recursive: true);
+            }
+
+            Environment.SetEnvironmentVariable("PAL3_PRESENTATION_SANDBOX_OUT", outputDirectory);
+
+            try
+            {
+                ProceduralProjectileSandboxCapture.Capture();
+            }
+            finally
+            {
+                Environment.SetEnvironmentVariable("PAL3_PRESENTATION_SANDBOX_OUT", null);
+            }
+
+            Assert.That(Directory.Exists(outputDirectory), Is.True);
+
+            foreach (string fileName in ExpectedPngFiles)
+            {
+                string path = Path.Combine(outputDirectory, fileName);
+                Assert.That(File.Exists(path), Is.True, $"Missing sandbox frame: {fileName}");
+
+                byte[] bytes = File.ReadAllBytes(path);
+                Assert.That(bytes.Length, Is.GreaterThan(8), $"Empty sandbox frame: {fileName}");
+                Assert.That(bytes[0], Is.EqualTo(137), $"Invalid PNG signature: {fileName}");
+                Assert.That(bytes[1], Is.EqualTo(80), $"Invalid PNG signature: {fileName}");
+                Assert.That(bytes[2], Is.EqualTo(78), $"Invalid PNG signature: {fileName}");
+                Assert.That(bytes[3], Is.EqualTo(71), $"Invalid PNG signature: {fileName}");
+            }
+
+            string manifestPath = Path.Combine(outputDirectory, "manifest.txt");
+            Assert.That(File.Exists(manifestPath), Is.True);
+
+            string manifest = File.ReadAllText(manifestPath);
+            StringAssert.Contains(
+                "Unity editor renderer + ProceduralCombatVfx only; not PAL3 combat runtime.",
+                manifest);
+            StringAssert.Contains("01_cast.png|phase=Cast", manifest);
+            StringAssert.Contains("06_impact.png|phase=Impact", manifest);
+        }
+    }
+}
