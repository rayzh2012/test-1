+
+        private static CombatantState Caster()
+        {
+            return new CombatantState(
+                maxHp: 100,
+                attack: 20,
+                defense: 10,
+                maxMp: 50);
+        }
+
+        private static CombatantState AllyState(int hp = 100)
+        {
+            return new CombatantState(
+                maxHp: hp,
+                attack: 10,
+                defense: 5);
+        }
+
+        private static CombatTargetSlot<string> First(
+            string key,
+            CombatantState state,
+            int row,
+            int column)
+        {
+            return new CombatTargetSlot<string>(
+                key,
+                state,
+                CombatParty.First,
+                row,
+                column);
+        }
+
+        private static CombatTargetSlot<string> Enemy(
+            string key,
+            CombatantState state,
+            int row,
+            int column)
+        {
+            return new CombatTargetSlot<string>(
+                key,
+                state,
+                CombatParty.Enemy,
+                row,
+                column);
+        }
+
+        private static void Damage(CombatantState target, int damage)
+        {
+            CombatantState attacker =
+                new(maxHp: 100, attack: damage + target.Defense, defense: 0);
+            NormalAttackResolver.Resolve(attacker, target);
+        }
+
+        private static void Defeat(CombatantState target)
+        {
+            CombatantState attacker =
+                new(maxHp: 100, attack: 9999, defense: 0);
+            NormalAttackResolver.Resolve(attacker, target);
+        }
+
+        private static SkillDefinition RecoverySkill(
+            TargetRangeType targetRange,
+            AttributeImpactType impactType,
+            int value,
+            int mpCost = 10,
+            SkillType type = SkillType.RecoverMagic)
+        {
+            return new SkillDefinition(
+                id: 8201,
+                name: "Recovery Test",
+                type,
+                element: ElementType.None,
+                targetRange,
+                mpCost,
+                spCost: 0,
+                visualArchetype: SkillVisualArchetype.SupportPulse,
+                visualProfileKey: "support.hp.basic",
+                effects: new[]
+                {
+                    SkillEffectDefinition.ForAttribute(
+                        ActorAttributeType.Hp,
+                        impactType,
+                        value),
+                });
+        }
+    }
