+namespace Pal3.Game.Tests.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Linq;
+    using NUnit.Framework;
+    using Pal3.Core.Contract.Enums;
+    using Pal3.Game.GameSystems.Combat.Domain;
+
+    public sealed class RecoverySkillResolverTests
+    {
+        [Test]
+        public void AbsoluteSingle_HealsTargetAndSpendsMpOnce()
+        {
+            CombatantState caster = Caster();
+            CombatantState ally = AllyState(hp: 100);
+            Damage(ally, 35);
+            CombatTargetSlot<string>[] slots =
+            {
+                First("ally", ally, row: 0, column: 0),
+            };
+            SkillDefinition skill = RecoverySkill(
+                TargetRangeType.FirstPartySingle,
+                AttributeImpactType.Absolute,
+                value: 25,
+                mpCost: 12);
+
+            RecoverySkillCastResolution<string> result =
+                RecoverySkillResolver<string>.Resolve(caster, slots, skill, "ally");
+
+            Assert.That(caster.CurrentMp, Is.EqualTo(38));
+            Assert.That(ally.CurrentHp, Is.EqualTo(90));
+            Assert.That(result.Targets.Single().Healing, Is.EqualTo(25));
+            Assert.That(result.Targets.Single().Events.Single().Kind,
+                Is.EqualTo(CombatEventKind.Healing));
+            Assert.That(result.Targets.Single().Events.Single().Amount, Is.EqualTo(25));
+            Assert.That(result.CastEvents.Single().Kind, Is.EqualTo(CombatEventKind.SkillCast));
+        }
+
