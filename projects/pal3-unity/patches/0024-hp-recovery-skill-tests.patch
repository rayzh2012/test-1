+        [Test]
+        public void ResultCollections_AreReadOnlyWrappersNotRawArrays()
+        {
+            CombatantState caster = Caster();
+            CombatantState ally = AllyState();
+            Damage(ally, 20);
+            CombatTargetSlot<string>[] slots =
+            {
+                First("ally", ally, 0, 0),
+            };
+            SkillDefinition skill = RecoverySkill(
+                TargetRangeType.FirstPartyAll,
+                AttributeImpactType.Absolute,
+                value: 10);
+
+            RecoverySkillCastResolution<string> result =
+                RecoverySkillResolver<string>.Resolve(caster, slots, skill);
+
+            Assert.That(result.CastEvents, Is.Not.InstanceOf<CombatEvent[]>());
+            Assert.That(
+                result.Targets,
+                Is.Not.InstanceOf<RecoveryTargetResolution<string>[]>());
