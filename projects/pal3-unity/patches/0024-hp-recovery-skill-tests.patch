+        [Test]
+        public void FirstPartyAll_HealsEveryLivingAllyInFormationOrderAndSpendsMpOnce()
+        {
+            CombatantState caster = Caster();
+            CombatantState allyB = AllyState();
+            CombatantState allyA = AllyState();
+            CombatantState dead = AllyState();
+            Damage(allyA, 30);
+            Damage(allyB, 50);
+            Defeat(dead);
+            CombatTargetSlot<string>[] slots =
+            {
+                First("b", allyB, row: 1, column: 0),
+                First("dead", dead, row: 0, column: 0),
+                First("a", allyA, row: 0, column: 1),
+                Enemy("enemy", AllyState(), row: 0, column: 0),
+            };
+            SkillDefinition skill = RecoverySkill(
+                TargetRangeType.FirstPartyAll,
+                AttributeImpactType.Absolute,
+                value: 20,
+                mpCost: 15);
+
+            RecoverySkillCastResolution<string> result =
+                RecoverySkillResolver<string>.Resolve(caster, slots, skill);
+
+            Assert.That(caster.CurrentMp, Is.EqualTo(35));
+            Assert.That(allyA.CurrentHp, Is.EqualTo(90));
+            Assert.That(allyB.CurrentHp, Is.EqualTo(70));
+            Assert.That(dead.CurrentHp, Is.Zero);
+            Assert.That(result.Targets.Select(target => target.TargetKey),
+                Is.EqualTo(new[] { "a", "b" }));
+        }
