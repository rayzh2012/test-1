@@ -0,0 +1,94 @@
+namespace Pal3.Game.Tests.GameSystems.Combat.Core
+{
+    using System;
+    using NUnit.Framework;
+    using Pal3.Game.GameSystems.Combat.Core;
+
+    public sealed class CombatCoreTests
+    {
+        [Test]
+        public void NormalAttack_AppliesAttackMinusDefense()
+        {
+            CombatantState attacker = new(maxHp: 100, attack: 30, defense: 5);
+            CombatantState defender = new(maxHp: 100, attack: 10, defense: 12);
+
+            NormalAttackResolution result = NormalAttackResolver.Resolve(attacker, defender);
+
+            Assert.That(result.Damage, Is.EqualTo(18));
+            Assert.That(defender.CurrentHp, Is.EqualTo(82));
+            Assert.That(result.IsTargetDefeated, Is.False);
+        }
+
+        [Test]
+        public void NormalAttack_AlwaysDealsAtLeastOneDamage()
+        {
+            CombatantState attacker = new(maxHp: 100, attack: 5, defense: 5);
+            CombatantState defender = new(maxHp: 100, attack: 10, defense: 999);
+
+            NormalAttackResolution result = NormalAttackResolver.Resolve(attacker, defender);
+
+            Assert.That(result.Damage, Is.EqualTo(1));
+            Assert.That(defender.CurrentHp, Is.EqualTo(99));
+        }
+
+        [Test]
+        public void NormalAttack_ClampsDamageAtRemainingHpAndMarksDefeat()
+        {
+            CombatantState attacker = new(maxHp: 100, attack: 500, defense: 0);
+            CombatantState defender = new(maxHp: 40, attack: 10, defense: 0);
+
+            NormalAttackResolution result = NormalAttackResolver.Resolve(attacker, defender);
+
+            Assert.That(result.Damage, Is.EqualTo(40));
+            Assert.That(defender.CurrentHp, Is.Zero);
+            Assert.That(defender.IsAlive, Is.False);
+            Assert.That(result.IsTargetDefeated, Is.True);
+        }
+
+        [Test]
+        public void Duel_PlayerKillTransitionsToPlayerWin()
+        {
+            CombatDuel duel = new(
+                new CombatantState(maxHp: 100, attack: 100, defense: 0),
+                new CombatantState(maxHp: 20, attack: 10, defense: 0));
+
+            duel.ResolvePlayerNormalAttack();
+
+            Assert.That(duel.Outcome, Is.EqualTo(DuelOutcome.PlayerWin));
+        }
+
+        [Test]
+        public void Duel_EnemyKillTransitionsToPlayerLose()
+        {
+            CombatDuel duel = new(
+                new CombatantState(maxHp: 20, attack: 10, defense: 0),
+                new CombatantState(maxHp: 100, attack: 100, defense: 0));
+
+            duel.ResolveEnemyNormalAttack();
+
+            Assert.That(duel.Outcome, Is.EqualTo(DuelOutcome.PlayerLose));
+        }
+
+        [Test]
+        public void Duel_RejectsActionsAfterTerminalOutcome()
+        {
+            CombatDuel duel = new(
+                new CombatantState(maxHp: 100, attack: 100, defense: 0),
+                new CombatantState(maxHp: 20, attack: 10, defense: 0));
+
+            duel.ResolvePlayerNormalAttack();
+
+            Assert.Throws<InvalidOperationException>(() => duel.ResolvePlayerNormalAttack());
+        }
+
+        [TestCase(0, 1, 1)]
+        [TestCase(-1, 1, 1)]
+        [TestCase(10, -1, 1)]
+        [TestCase(10, 1, -1)]
+        public void CombatantState_RejectsInvalidStats(int maxHp, int attack, int defense)
+        {
+            Assert.Throws<ArgumentOutOfRangeException>(
+                () => new CombatantState(maxHp, attack, defense));
+        }
+    }
+}
