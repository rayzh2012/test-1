+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity combat-core feasibility slice.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.Combat.Core
+{
+    using System;
+
+    /// <summary>
+    /// Outcome of the smallest deterministic 1v1 combat slice.
+    /// This is intentionally independent of Unity presentation.
+    /// </summary>
+    public enum DuelOutcome
+    {
+        InProgress = 0,
+        PlayerWin = 1,
+        PlayerLose = 2,
+    }
+
+    /// <summary>
+    /// Minimal mutable combat state used by the pure C# combat domain.
+    /// More PAL3 attributes can be mapped in after the integration boundary is proven.
+    /// </summary>
+    public sealed class CombatantState
+    {
+        public int MaxHp { get; }
+        public int CurrentHp { get; private set; }
+        public int Attack { get; }
+        public int Defense { get; }
+
+        public bool IsAlive => CurrentHp > 0;
+
+        public CombatantState(int maxHp, int attack, int defense)
+        {
+            if (maxHp <= 0) throw new ArgumentOutOfRangeException(nameof(maxHp));
+            if (attack < 0) throw new ArgumentOutOfRangeException(nameof(attack));
+            if (defense < 0) throw new ArgumentOutOfRangeException(nameof(defense));
+
+            MaxHp = maxHp;
+            CurrentHp = maxHp;
+            Attack = attack;
+            Defense = defense;
+        }
+
+        internal int ApplyDamage(int damage)
+        {
+            if (damage < 0) throw new ArgumentOutOfRangeException(nameof(damage));
+            if (!IsAlive) return 0;
+
+            int appliedDamage = Math.Min(CurrentHp, damage);
+            CurrentHp -= appliedDamage;
+            return appliedDamage;
+        }
+    }
+
+    public readonly struct NormalAttackResolution
+    {
+        public int Damage { get; }
+        public bool IsTargetDefeated { get; }
+
+        public NormalAttackResolution(int damage, bool isTargetDefeated)
+        {
+            Damage = damage;
+            IsTargetDefeated = isTargetDefeated;
+        }
+    }
+
+    /// <summary>
+    /// Deterministic normal-attack resolver for the feasibility slice.
+    /// </summary>
+    public static class NormalAttackResolver
+    {
+        public static NormalAttackResolution Resolve(CombatantState attacker, CombatantState defender)
+        {
+            if (attacker == null) throw new ArgumentNullException(nameof(attacker));
+            if (defender == null) throw new ArgumentNullException(nameof(defender));
+            if (!attacker.IsAlive) throw new InvalidOperationException("A defeated combatant cannot attack.");
+            if (!defender.IsAlive) throw new InvalidOperationException("A defeated combatant cannot be targeted.");
+
+            // FEASIBILITY BASELINE ONLY:
+            // This is deliberately NOT a claim about PAL3's original damage formula.
+            // Replace this model only after formula evidence is locked.
+            int damage = Math.Max(1, attacker.Attack - defender.Defense);
+            int appliedDamage = defender.ApplyDamage(damage);
+
+            return new NormalAttackResolution(appliedDamage, !defender.IsAlive);
+        }
+    }
+
+    /// <summary>
+    /// Smallest end-to-end combat state machine: player and enemy trade normal attacks
+    /// until one side is defeated.
+    /// </summary>
+    public sealed class CombatDuel
+    {
+        public CombatantState Player { get; }
+        public CombatantState Enemy { get; }
+
+        public DuelOutcome Outcome { get; private set; } = DuelOutcome.InProgress;
+
+        public CombatDuel(CombatantState player, CombatantState enemy)
+        {
+            Player = player ?? throw new ArgumentNullException(nameof(player));
+            Enemy = enemy ?? throw new ArgumentNullException(nameof(enemy));
+        }
+
+        public NormalAttackResolution ResolvePlayerNormalAttack()
+        {
+            return ResolveNormalAttack(Player, Enemy, DuelOutcome.PlayerWin);
+        }
+
+        public NormalAttackResolution ResolveEnemyNormalAttack()
+        {
+            return ResolveNormalAttack(Enemy, Player, DuelOutcome.PlayerLose);
+        }
+
+        private NormalAttackResolution ResolveNormalAttack(
+            CombatantState attacker,
+            CombatantState defender,
+            DuelOutcome terminalOutcome)
+        {
+            if (Outcome != DuelOutcome.InProgress)
+            {
+                throw new InvalidOperationException("The duel has already ended.");
+            }
+
+            NormalAttackResolution resolution = NormalAttackResolver.Resolve(attacker, defender);
+
+            if (resolution.IsTargetDefeated)
+            {
+                Outcome = terminalOutcome;
+            }
+
+            return resolution;
+        }
+    }
+}
diff --git a/Assets/Tests/EditMode/CombatCoreTests.cs b/Assets/Tests/EditMode/CombatCoreTests.cs
new file mode 100644
