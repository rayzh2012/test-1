+            CombatTargetSlot<string>[] slots =
+            {
+                new("enemy-a", sharedEnemy, CombatParty.Enemy, row: 0, column: 0),
+                new("enemy-b", sharedEnemy, CombatParty.Enemy, row: 0, column: 1),
+            };
+            SkillDefinition skill = CreateDamageSkill(
+                TargetRangeType.EnemyPartyAll,
+                mpCost: 10,
+                damage: 20);
+
+            Assert.Throws<InvalidOperationException>(() =>
+                MultiTargetSkillResolver<string>.Resolve(caster, slots, skill));
+
+            Assert.That(caster.CurrentMp, Is.EqualTo(50));
+            Assert.That(sharedEnemy.CurrentHp, Is.EqualTo(100));
+        }
