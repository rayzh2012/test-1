         public void ExitCombat()
         {
+            foreach (CombatActorController controller in _runtimeCombatStates.Keys)
+            {
+                controller.NormalAttackHit -= OnNormalAttackHit;
+            }
+
+            _runtimeCombatStates.Clear();
+
             // Stop combat music
             Pal3.Instance.Execute(new StopScriptMusicCommand());
             Pal3.Instance.Execute(new CameraFadeInCommand());
             _sceneManager.UnloadCombatScene();
             ResetCameraPosition();
+        }
+
+        private void InitializeRuntimeCombatState(Dictionary<ElementPosition, CombatActorInfo> combatActors)
+        {
+            _runtimeCombatStates = new CombatRuntimeRegistry<CombatActorController>();
+
+            foreach ((ElementPosition elementPosition, CombatActorInfo actorInfo) in combatActors)
+            {
+                CombatActorController controller = _combatScene.GetCombatActorController(elementPosition);
+                if (controller == null) continue;
+
+                int hp = Math.Max(1, GetInitialAttribute(actorInfo, ActorAttributeType.Hp, 1));
+                int attack = Math.Max(0, GetInitialAttribute(actorInfo, ActorAttributeType.Attack, 0));
+                int defense = Math.Max(0, GetInitialAttribute(actorInfo, ActorAttributeType.Defense, 0));
+
+                _runtimeCombatStates.Register(
+                    controller,
+                    new CombatantState(maxHp: hp, attack: attack, defense: defense));
+
+                controller.NormalAttackHit -= OnNormalAttackHit;
+                controller.NormalAttackHit += OnNormalAttackHit;
+            }
+        }
+
+        private static int GetInitialAttribute(
+            CombatActorInfo actorInfo,
+            ActorAttributeType attributeType,
+            int fallbackValue)
+        {
+            if (actorInfo.AttributeValues != null &&
+                actorInfo.AttributeValues.TryGetValue(attributeType, out int value))
+            {
+                return value;
+            }
+
+            return fallbackValue;
+        }
+
+        private void OnNormalAttackHit(
+            CombatActorController attackerController,
+            CombatActorController targetController)
+        {
+            CombatantState attackerState = _runtimeCombatStates.Get(attackerController);
+            CombatantState targetState = _runtimeCombatStates.Get(targetController);
+
+            if (!attackerState.IsAlive || !targetState.IsAlive)
+            {
+                return;
+            }
+
+            NormalAttackResolution resolution =
+                _runtimeCombatStates.ResolveNormalAttack(attackerController, targetController);
+
+            EngineLogger.Log(
+                $"Normal attack resolved: damage={resolution.Damage}, " +
+                $"targetHp={targetState.CurrentHp}/{targetState.MaxHp}, " +
+                $"defeated={resolution.IsTargetDefeated}");
         }
 
