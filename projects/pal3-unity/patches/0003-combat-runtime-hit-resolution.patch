+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity combat runtime state registry.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Collections.Generic;
+
+    /// <summary>
+    /// Owns mutable combatant state for one combat encounter.
+    /// Keys are presentation/runtime handles; states remain pure C# domain objects.
+    /// </summary>
+    public sealed class CombatRuntimeRegistry<TKey> where TKey : class
+    {
+        private readonly Dictionary<TKey, CombatantState> _states = new();
+
+        public IEnumerable<TKey> Keys => _states.Keys;
+
+        public int Count => _states.Count;
+
+        public void Register(TKey key, CombatantState state)
+        {
+            if (key == null) throw new ArgumentNullException(nameof(key));
+            if (state == null) throw new ArgumentNullException(nameof(state));
+
+            if (!_states.TryAdd(key, state))
+            {
+                throw new InvalidOperationException("Combatant runtime state is already registered.");
+            }
+        }
+
+        public CombatantState Get(TKey key)
+        {
+            if (key == null) throw new ArgumentNullException(nameof(key));
+
+            if (!_states.TryGetValue(key, out CombatantState state))
+            {
+                throw new KeyNotFoundException("Combatant runtime state is not registered.");
+            }
+
+            return state;
+        }
+
+        public NormalAttackResolution ResolveNormalAttack(TKey attacker, TKey defender)
+        {
+            return NormalAttackResolver.Resolve(Get(attacker), Get(defender));
+        }
+
+        public void Clear()
+        {
+            _states.Clear();
+        }
+    }
+}
