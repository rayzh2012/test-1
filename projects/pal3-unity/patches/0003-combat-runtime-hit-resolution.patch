+namespace Pal3.Game.Tests.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Collections.Generic;
+    using NUnit.Framework;
+    using Pal3.Game.GameSystems.Combat.Domain;
+
+    public sealed class CombatRuntimeRegistryTests
+    {
+        [Test]
+        public void RegisterAndGet_ReturnsEncounterState()
+        {
+            object key = new();
+            CombatantState state = new(maxHp: 100, attack: 30, defense: 10);
+            CombatRuntimeRegistry<object> registry = new();
+
+            registry.Register(key, state);
+
+            Assert.That(registry.Get(key), Is.SameAs(state));
+            Assert.That(registry.Count, Is.EqualTo(1));
+        }
+
+        [Test]
+        public void Register_DuplicateKeyIsRejected()
+        {
+            object key = new();
+            CombatRuntimeRegistry<object> registry = new();
+            registry.Register(key, new CombatantState(100, 20, 10));
+
+            Assert.Throws<InvalidOperationException>(
+                () => registry.Register(key, new CombatantState(100, 20, 10)));
+        }
+
+        [Test]
+        public void Get_UnknownKeyIsRejected()
+        {
+            CombatRuntimeRegistry<object> registry = new();
+
+            Assert.Throws<KeyNotFoundException>(() => registry.Get(new object()));
+        }
+
+        [Test]
+        public void ResolveNormalAttack_MutatesOnlyRuntimeDefenderState()
+        {
+            object attacker = new();
+            object defender = new();
+            CombatRuntimeRegistry<object> registry = new();
+            registry.Register(attacker, new CombatantState(maxHp: 100, attack: 35, defense: 5));
+            registry.Register(defender, new CombatantState(maxHp: 80, attack: 10, defense: 15));
+
+            NormalAttackResolution result = registry.ResolveNormalAttack(attacker, defender);
+
+            Assert.That(result.Damage, Is.EqualTo(20));
+            Assert.That(registry.Get(attacker).CurrentHp, Is.EqualTo(100));
+            Assert.That(registry.Get(defender).CurrentHp, Is.EqualTo(60));
+        }
+
+        [Test]
+        public void Clear_RemovesEncounterState()
+        {
+            object key = new();
+            CombatRuntimeRegistry<object> registry = new();
+            registry.Register(key, new CombatantState(100, 20, 10));
+
+            registry.Clear();
+
+            Assert.That(registry.Count, Is.Zero);
+            Assert.Throws<KeyNotFoundException>(() => registry.Get(key));
+        }
+    }
+}
