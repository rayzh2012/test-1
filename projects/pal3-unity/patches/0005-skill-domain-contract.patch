+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity combat skill domain contract.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Collections.Generic;
+    using System.Linq;
+    using Pal3.Core.Contract.Enums;
+
+    public enum SkillVisualArchetype
+    {
+        MeleeImpact = 0,
+        Projectile,
+        DescendStrike,
+        AreaBurst,
+        GroundField,
+        SupportPulse,
+        SelfAura,
+        BossSpecial,
+    }
+
+    public enum SkillEffectKind
+    {
+        AttributeImpact = 0,
+        CombatStateImpact,
+    }
+
+    public sealed class SkillEffectDefinition
+    {
+        public SkillEffectKind Kind { get; }
+
+        public ActorAttributeType AttributeType { get; }
+        public AttributeImpactType AttributeImpactType { get; }
+        public int Value { get; }
+
+        public ActorCombatStateType CombatStateType { get; }
+        public CombatStateImpactType CombatStateImpactType { get; }
+
+        private SkillEffectDefinition(
+            SkillEffectKind kind,
+            ActorAttributeType attributeType,
+            AttributeImpactType attributeImpactType,
+            int value,
+            ActorCombatStateType combatStateType,
+            CombatStateImpactType combatStateImpactType)
+        {
+            Kind = kind;
+            AttributeType = attributeType;
+            AttributeImpactType = attributeImpactType;
+            Value = value;
+            CombatStateType = combatStateType;
+            CombatStateImpactType = combatStateImpactType;
+        }
+
+        public static SkillEffectDefinition ForAttribute(
+            ActorAttributeType attributeType,
+            AttributeImpactType impactType,
+            int value)
+        {
+            return new SkillEffectDefinition(
+                SkillEffectKind.AttributeImpact,
+                attributeType,
+                impactType,
+                value,
+                default,
+                CombatStateImpactType.None);
+        }
+
+        public static SkillEffectDefinition ForCombatState(
+            ActorCombatStateType combatStateType,
+            CombatStateImpactType impactType)
+        {
+            if (impactType == CombatStateImpactType.None)
+            {
+                throw new ArgumentOutOfRangeException(nameof(impactType),
+                    "Combat-state effects must either apply or remove a state.");
+            }
+
+            return new SkillEffectDefinition(
+                SkillEffectKind.CombatStateImpact,
+                default,
+                AttributeImpactType.Absolute,
+                value: 0,
+                combatStateType,
+                impactType);
+        }
+    }
+
+    /// <summary>
+    /// Presentation-independent combat skill contract.
+    /// Mechanics may become arbitrarily rich while presentation remains mapped to a small
+    /// reusable set of visual archetypes/profiles.
+    /// </summary>
+    public sealed class SkillDefinition
+    {
+        private readonly SkillEffectDefinition[] _effects;
+
+        public uint Id { get; }
+        public string Name { get; }
+        public SkillType Type { get; }
+        public ElementType Element { get; }
+        public TargetRangeType TargetRange { get; }
+        public int MpCost { get; }
+        public int SpCost { get; }
+        public SkillVisualArchetype VisualArchetype { get; }
+        public string VisualProfileKey { get; }
+        public IReadOnlyList<SkillEffectDefinition> Effects => _effects;
+
+        public SkillDefinition(
+            uint id,
+            string name,
+            SkillType type,
+            ElementType element,
+            TargetRangeType targetRange,
+            int mpCost,
+            int spCost,
+            SkillVisualArchetype visualArchetype,
+            string visualProfileKey,
+            IEnumerable<SkillEffectDefinition> effects)
+        {
+            if (id == 0) throw new ArgumentOutOfRangeException(nameof(id));
+            if (string.IsNullOrWhiteSpace(name)) throw new ArgumentException("Skill name is required.", nameof(name));
+            if (targetRange == TargetRangeType.None)
+            {
+                throw new ArgumentOutOfRangeException(nameof(targetRange), "A combat skill requires an explicit target range.");
+            }
+            if (mpCost < 0) throw new ArgumentOutOfRangeException(nameof(mpCost));
+            if (spCost < 0) throw new ArgumentOutOfRangeException(nameof(spCost));
+            if (string.IsNullOrWhiteSpace(visualProfileKey))
+            {
+                throw new ArgumentException("A visual profile key is required.", nameof(visualProfileKey));
+            }
+            if (effects == null) throw new ArgumentNullException(nameof(effects));
+
+            _effects = effects.ToArray();
+            if (_effects.Length == 0)
+            {
+                throw new ArgumentException("A combat skill must contain at least one effect.", nameof(effects));
+            }
+            if (_effects.Any(effect => effect == null))
+            {
+                throw new ArgumentException("Skill effects cannot contain null entries.", nameof(effects));
+            }
+
+            Id = id;
+            Name = name;
+            Type = type;
+            Element = element;
+            TargetRange = targetRange;
+            MpCost = mpCost;
+            SpCost = spCost;
+            VisualArchetype = visualArchetype;
+            VisualProfileKey = visualProfileKey;
+        }
+    }
+}
