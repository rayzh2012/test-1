+namespace Pal3.Game.Tests.GameSystems.Combat.Domain
+{
+    using System;
+    using NUnit.Framework;
+    using Pal3.Core.Contract.Enums;
+    using Pal3.Game.GameSystems.Combat.Domain;
+
+    public sealed class SkillDefinitionTests
+    {
+        [Test]
+        public void SkillDefinition_PreservesMultipleIndependentEffects()
+        {
+            SkillDefinition skill = new(
+                id: 1001,
+                name: "Test Flame",
+                type: SkillType.DamageMagic,
+                element: ElementType.Fire,
+                targetRange: TargetRangeType.EnemyPartySingle,
+                mpCost: 12,
+                spCost: 0,
+                visualArchetype: SkillVisualArchetype.Projectile,
+                visualProfileKey: "fire.projectile.basic",
+                effects: new[]
+                {
+                    SkillEffectDefinition.ForAttribute(
+                        ActorAttributeType.Hp,
+                        AttributeImpactType.Absolute,
+                        value: -30),
+                    SkillEffectDefinition.ForCombatState(
+                        ActorCombatStateType.PoisonFire,
+                        CombatStateImpactType.Increase),
+                });
+
+            Assert.That(skill.Effects, Has.Count.EqualTo(2));
+            Assert.That(skill.Effects[0].Kind, Is.EqualTo(SkillEffectKind.AttributeImpact));
+            Assert.That(skill.Effects[1].Kind, Is.EqualTo(SkillEffectKind.CombatStateImpact));
+        }
+
+        [Test]
+        public void AttributeEffect_PreservesAttributeImpactContract()
+        {
+            SkillEffectDefinition effect = SkillEffectDefinition.ForAttribute(
+                ActorAttributeType.Hp,
+                AttributeImpactType.Percentage,
+                value: 25);
+
+            Assert.That(effect.Kind, Is.EqualTo(SkillEffectKind.AttributeImpact));
+            Assert.That(effect.AttributeType, Is.EqualTo(ActorAttributeType.Hp));
+            Assert.That(effect.AttributeImpactType, Is.EqualTo(AttributeImpactType.Percentage));
+            Assert.That(effect.Value, Is.EqualTo(25));
+        }
+
+        [Test]
+        public void CombatStateEffect_PreservesStateImpactContract()
+        {
+            SkillEffectDefinition effect = SkillEffectDefinition.ForCombatState(
+                ActorCombatStateType.Seal,
+                CombatStateImpactType.Increase);
+
+            Assert.That(effect.Kind, Is.EqualTo(SkillEffectKind.CombatStateImpact));
+            Assert.That(effect.CombatStateType, Is.EqualTo(ActorCombatStateType.Seal));
+            Assert.That(effect.CombatStateImpactType, Is.EqualTo(CombatStateImpactType.Increase));
+        }
+
+        [Test]
+        public void CombatStateEffect_RejectsNoOpImpact()
+        {
+            Assert.Throws<ArgumentOutOfRangeException>(() =>
+                SkillEffectDefinition.ForCombatState(
+                    ActorCombatStateType.Seal,
+                    CombatStateImpactType.None));
+        }
+
+        [Test]
+        public void SkillDefinition_SeparatesMechanicsFromVisualProfile()
+        {
+            SkillEffectDefinition[] effects =
+            {
+                SkillEffectDefinition.ForAttribute(
+                    ActorAttributeType.Hp,
+                    AttributeImpactType.Absolute,
+                    value: -20),
+            };
+
+            SkillDefinition projectile = CreateSkill(
+                visualArchetype: SkillVisualArchetype.Projectile,
+                visualProfileKey: "fire.projectile.basic",
+                effects);
+
+            SkillDefinition burst = CreateSkill(
+                visualArchetype: SkillVisualArchetype.AreaBurst,
+                visualProfileKey: "fire.area.basic",
+                effects);
+
+            Assert.That(projectile.Effects[0].Value, Is.EqualTo(burst.Effects[0].Value));
+            Assert.That(projectile.TargetRange, Is.EqualTo(burst.TargetRange));
+            Assert.That(projectile.VisualArchetype, Is.Not.EqualTo(burst.VisualArchetype));
+            Assert.That(projectile.VisualProfileKey, Is.Not.EqualTo(burst.VisualProfileKey));
+        }
+
+        [Test]
+        public void SkillDefinition_RejectsEmptyEffectList()
+        {
+            Assert.Throws<ArgumentException>(() => CreateSkill(
+                SkillVisualArchetype.Projectile,
+                "fire.projectile.basic",
+                Array.Empty<SkillEffectDefinition>()));
+        }
+
+        [TestCase(-1, 0)]
+        [TestCase(0, -1)]
+        public void SkillDefinition_RejectsNegativeResourceCosts(int mpCost, int spCost)
+        {
+            Assert.Throws<ArgumentOutOfRangeException>(() => new SkillDefinition(
+                id: 1001,
+                name: "Test",
+                type: SkillType.DamageMagic,
+                element: ElementType.Fire,
+                targetRange: TargetRangeType.EnemyPartySingle,
+                mpCost,
+                spCost,
+                SkillVisualArchetype.Projectile,
+                "fire.projectile.basic",
+                new[]
+                {
+                    SkillEffectDefinition.ForAttribute(
+                        ActorAttributeType.Hp,
+                        AttributeImpactType.Absolute,
+                        value: -10),
+                }));
+        }
+
+        [Test]
+        public void SkillDefinition_RejectsMissingTargetRange()
+        {
+            Assert.Throws<ArgumentOutOfRangeException>(() => new SkillDefinition(
+                id: 1001,
+                name: "Test",
+                type: SkillType.DamageMagic,
+                element: ElementType.Fire,
+                targetRange: TargetRangeType.None,
+                mpCost: 0,
+                spCost: 0,
+                SkillVisualArchetype.Projectile,
+                "fire.projectile.basic",
+                new[]
+                {
+                    SkillEffectDefinition.ForAttribute(
+                        ActorAttributeType.Hp,
+                        AttributeImpactType.Absolute,
+                        value: -10),
+                }));
+        }
+
+        [Test]
+        public void SkillDefinition_RejectsBlankVisualProfileKey()
+        {
+            Assert.Throws<ArgumentException>(() => CreateSkill(
+                SkillVisualArchetype.Projectile,
+                " ",
+                new[]
+                {
+                    SkillEffectDefinition.ForAttribute(
+                        ActorAttributeType.Hp,
+                        AttributeImpactType.Absolute,
+                        value: -10),
+                }));
+        }
+
+        private static SkillDefinition CreateSkill(
+            SkillVisualArchetype visualArchetype,
+            string visualProfileKey,
+            SkillEffectDefinition[] effects)
+        {
+            return new SkillDefinition(
+                id: 1001,
+                name: "Test",
+                type: SkillType.DamageMagic,
+                element: ElementType.Fire,
+                targetRange: TargetRangeType.EnemyPartySingle,
+                mpCost: 10,
+                spCost: 0,
+                visualArchetype,
+                visualProfileKey,
+                effects);
+        }
+    }
+}
