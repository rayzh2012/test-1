+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity deterministic HP recovery skill execution.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Collections.Generic;
+    using System.Linq;
+    using Pal3.Core.Contract.Enums;
+
+    public sealed class RecoveryTargetResolution<TKey> where TKey : notnull
+    {
+        private readonly IReadOnlyList<CombatEvent> _events;
+
+        public TKey TargetKey { get; }
+        public int Healing { get; }
+        public bool IsAtMaxHp { get; }
+        public IReadOnlyList<CombatEvent> Events => _events;
+
+        public RecoveryTargetResolution(
+            TKey targetKey,
+            uint skillId,
+            int healing,
+            bool isAtMaxHp)
+        {
+            if (targetKey is null) throw new ArgumentNullException(nameof(targetKey));
+            if (healing < 0) throw new ArgumentOutOfRangeException(nameof(healing));
+
+            TargetKey = targetKey;
+            Healing = healing;
+            IsAtMaxHp = isAtMaxHp;
+            _events = Array.AsReadOnly(new[]
+            {
+                CombatEvent.ForHealing(skillId, healing),
+            });
+        }
+    }
+
+    public sealed class RecoverySkillCastResolution<TKey> where TKey : notnull
+    {
+        private readonly IReadOnlyList<CombatEvent> _castEvents;
+        private readonly IReadOnlyList<RecoveryTargetResolution<TKey>> _targets;
+
+        public uint SkillId { get; }
+        public int MpSpent { get; }
+        public IReadOnlyList<CombatEvent> CastEvents => _castEvents;
+        public IReadOnlyList<RecoveryTargetResolution<TKey>> Targets => _targets;
+
+        public RecoverySkillCastResolution(
+            uint skillId,
+            int mpSpent,
+            IEnumerable<RecoveryTargetResolution<TKey>> targets)
+        {
+            if (skillId == 0) throw new ArgumentOutOfRangeException(nameof(skillId));
+            if (mpSpent < 0) throw new ArgumentOutOfRangeException(nameof(mpSpent));
+            if (targets == null) throw new ArgumentNullException(nameof(targets));
+
+            RecoveryTargetResolution<TKey>[] targetArray = targets.ToArray();
+            if (targetArray.Length == 0)
+            {
+                throw new ArgumentException(
+                    "A recovery cast requires at least one resolved target.",
+                    nameof(targets));
+            }
+            if (targetArray.Any(target => target == null))
+            {
+                throw new ArgumentException(
+                    "Recovery targets cannot contain null entries.",
+                    nameof(targets));
+            }
+            if (targetArray
+                .Select(target => target.TargetKey)
+                .Distinct(EqualityComparer<TKey>.Default)
+                .Count() != targetArray.Length)
+            {
+                throw new InvalidOperationException(
+                    "Recovery target keys must be unique.");
+            }
+
+            SkillId = skillId;
+            MpSpent = mpSpent;
+            _castEvents = Array.AsReadOnly(new[] { CombatEvent.ForSkillCast(skillId) });
+            _targets = Array.AsReadOnly(targetArray);
+        }
+    }
+
+    /// <summary>
+    /// First healing/support mechanics slice.
+    /// Scope is deliberately narrow: RecoverMagic, first-party single/all, one HP effect,
+    /// positive Absolute recovery or RecoverToMax, and no SP cost or combat-state effects.
+    /// Defeated targets are not revived by this slice.
+    /// </summary>
+    public static class RecoverySkillResolver<TKey> where TKey : notnull
+    {
+        public static RecoverySkillCastResolution<TKey> Resolve(
+            CombatantState caster,
+            IEnumerable<CombatTargetSlot<TKey>> slots,
+            SkillDefinition skill)
+        {
+            ValidateCommonInputs(caster, slots, skill);
+            if (skill.TargetRange != TargetRangeType.FirstPartyAll)
+            {
+                throw new ArgumentException(
+                    $"Target range {skill.TargetRange} requires an explicit ally anchor.",
+                    nameof(skill));
+            }
+
+            CombatTargetSlot<TKey>[] slotArray = slots.ToArray();
+            IReadOnlyList<TKey> targetKeys =
+                CombatTargetResolver<TKey>.Resolve(skill.TargetRange, slotArray);
+
+            return ResolveSelected(caster, slotArray, skill, targetKeys);
+        }
+
+        public static RecoverySkillCastResolution<TKey> Resolve(
+            CombatantState caster,
+            IEnumerable<CombatTargetSlot<TKey>> slots,
+            SkillDefinition skill,
+            TKey anchorKey)
+        {
+            ValidateCommonInputs(caster, slots, skill);
+            if (skill.TargetRange != TargetRangeType.FirstPartySingle)
+            {
+                throw new ArgumentException(
+                    $"Target range {skill.TargetRange} does not use a single-ally anchor in this slice.",
+                    nameof(skill));
+            }
+
+            CombatTargetSlot<TKey>[] slotArray = slots.ToArray();
+            IReadOnlyList<TKey> targetKeys =
+                CombatTargetResolver<TKey>.Resolve(skill.TargetRange, slotArray, anchorKey);
+
+            return ResolveSelected(caster, slotArray, skill, targetKeys);
+        }
+
+        private static RecoverySkillCastResolution<TKey> ResolveSelected(
+            CombatantState caster,
+            IReadOnlyList<CombatTargetSlot<TKey>> slots,
+            SkillDefinition skill,
+            IReadOnlyList<TKey> targetKeys)
+        {
+            if (targetKeys.Count == 0)
+            {
+                throw new InvalidOperationException(
+                    "A recovery skill requires at least one living first-party target.");
+            }
+
+            Dictionary<TKey, CombatantState> statesByKey = slots.ToDictionary(
+                slot => slot.Key,
+                slot => slot.State,
+                EqualityComparer<TKey>.Default);
+
+            CombatantState[] targets = targetKeys
+                .Select(key => statesByKey[key])
+                .ToArray();
+
+            for (int i = 0; i < targets.Length; i++)
+            {
+                for (int j = 0; j < i; j++)
+                {
+                    if (ReferenceEquals(targets[i], targets[j]))
+                    {
+                        throw new InvalidOperationException(
+                            "Selected recovery target keys must refer to distinct combatant states.");
+                    }
+                }
+            }
+
+            if (caster.CurrentMp < skill.MpCost)
+            {
+                throw new InvalidOperationException("Insufficient MP.");
+            }
+
+            SkillEffectDefinition effect = skill.Effects.Single();
+            int[] requestedHealing = targets
+                .Select(target => RequestedHealing(target, effect))
+                .ToArray();
+
+            if (!caster.TrySpendMp(skill.MpCost))
+            {
+                throw new InvalidOperationException("Insufficient MP.");
+            }
+
+            RecoveryTargetResolution<TKey>[] results =
+                new RecoveryTargetResolution<TKey>[targetKeys.Count];
+
+            for (int i = 0; i < targetKeys.Count; i++)
+            {
+                int appliedHealing = targets[i].RestoreHp(requestedHealing[i]);
+                results[i] = new RecoveryTargetResolution<TKey>(
+                    targetKeys[i],
+                    skill.Id,
+                    appliedHealing,
+                    targets[i].CurrentHp == targets[i].MaxHp);
+            }
+
+            return new RecoverySkillCastResolution<TKey>(
+                skill.Id,
+                skill.MpCost,
+                results);
+        }
+
+        private static int RequestedHealing(
+            CombatantState target,
+            SkillEffectDefinition effect)
+        {
+            return effect.AttributeImpactType switch
+            {
+                AttributeImpactType.Absolute => effect.Value,
+                AttributeImpactType.RecoverToMax => target.MaxHp - target.CurrentHp,
+                _ => throw new NotSupportedException(
+                    $"HP recovery impact type {effect.AttributeImpactType} is not supported by this slice."),
+            };
+        }
+
+        private static void ValidateCommonInputs(
+            CombatantState caster,
+            IEnumerable<CombatTargetSlot<TKey>> slots,
+            SkillDefinition skill)
+        {
+            if (caster == null) throw new ArgumentNullException(nameof(caster));
+            if (slots == null) throw new ArgumentNullException(nameof(slots));
+            if (skill == null) throw new ArgumentNullException(nameof(skill));
+            if (!caster.IsAlive)
+            {
+                throw new InvalidOperationException("A defeated combatant cannot cast a skill.");
+            }
+
+            ValidateSupportedSkill(skill);
+        }
+
+        private static void ValidateSupportedSkill(SkillDefinition skill)
+        {
+            if (skill.TargetRange is not (
+                TargetRangeType.FirstPartySingle or
+                TargetRangeType.FirstPartyAll))
+            {
+                throw new NotSupportedException(
+                    "This recovery slice only supports first-party single/all targets.");
+            }
+
+            if (skill.Type != SkillType.RecoverMagic)
+            {
+                throw new NotSupportedException(
+                    "This recovery slice only supports RecoverMagic.");
+            }
+
+            if (skill.SpCost != 0)
+            {
+                throw new NotSupportedException(
+                    "SP-consuming recovery skills are not supported by this slice.");
+            }
+
+            if (skill.Effects.Count != 1)
+            {
+                throw new NotSupportedException(
+                    "This recovery slice requires exactly one skill effect.");
+            }
+
+            SkillEffectDefinition effect = skill.Effects[0];
+            if (effect.Kind != SkillEffectKind.AttributeImpact ||
+                effect.AttributeType != ActorAttributeType.Hp)
+            {
+                throw new NotSupportedException(
+                    "This recovery slice only supports HP attribute impact.");
+            }
+
+            if (effect.AttributeImpactType == AttributeImpactType.Absolute)
+            {
+                if (effect.Value <= 0)
+                {
+                    throw new NotSupportedException(
+                        "Absolute HP recovery requires a positive value.");
+                }
+                return;
+            }
+
+            if (effect.AttributeImpactType != AttributeImpactType.RecoverToMax)
+            {
+                throw new NotSupportedException(
+                    $"HP recovery impact type {effect.AttributeImpactType} is not supported by this slice.");
+            }
+        }
+    }
+}
