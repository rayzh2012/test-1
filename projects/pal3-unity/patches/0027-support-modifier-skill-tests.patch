+            CombatantState state = NewState();
+
+            Assert.Throws<NotSupportedException>(() =>
+                state.GetSupportModifierPercent(ActorAttributeType.Hp));
+        }
+
+        private static CombatantState NewState(int maxMp = 0)
+        {
+            return new CombatantState(maxHp: 100, attack: 30, defense: 20, maxMp);
+        }
+
+        private static CombatTargetSlot<object>[] SingleFirstPartySlot(
+            object key,
+            CombatantState state)
+        {
+            return new[]
+            {
+                new CombatTargetSlot<object>(
+                    key,
+                    state,
+                    CombatParty.First,
+                    row: 0,
+                    column: 0),
+            };
+        }
+
+        private static SkillDefinition CreateSupportSkill(
+            ActorCombatStateType stateType,
+            CombatStateImpactType impactType,
+            int mpCost,
+            TargetRangeType targetRange = TargetRangeType.FirstPartySingle,
+            SkillType skillType = SkillType.AssistMagic,
+            int spCost = 0)
+        {
+            return new SkillDefinition(
+                id: 3001,
+                name: "Test Support",
+                type: skillType,
+                element: ElementType.None,
+                targetRange,
+                mpCost,
+                spCost,
+                visualArchetype: SkillVisualArchetype.SupportPulse,
+                visualProfileKey: "support.modifier.basic",
+                effects: new[]
+                {
+                    SkillEffectDefinition.ForCombatState(stateType, impactType),
+                });
+        }
+    }
