+namespace Pal3.Game.Tests.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Collections.Generic;
+    using NUnit.Framework;
+    using Pal3.Core.Contract.Enums;
+    using Pal3.Game.GameSystems.Combat.Domain;
+
+    public sealed class SupportModifierSkillResolverTests
+    {
+        [TestCase(ActorCombatStateType.AttackIncrease, ActorAttributeType.Attack, 10)]
+        [TestCase(ActorCombatStateType.AttackDecrease, ActorAttributeType.Attack, -10)]
+        [TestCase(ActorCombatStateType.DefenseIncrease, ActorAttributeType.Defense, 10)]
+        [TestCase(ActorCombatStateType.DefenseDecrease, ActorAttributeType.Defense, -10)]
+        [TestCase(ActorCombatStateType.SpeedIncrease, ActorAttributeType.Speed, 10)]
+        [TestCase(ActorCombatStateType.SpeedDecrease, ActorAttributeType.Speed, -10)]
+        [TestCase(ActorCombatStateType.LuckIncrease, ActorAttributeType.Luck, 10)]
+        [TestCase(ActorCombatStateType.LuckDecrease, ActorAttributeType.Luck, -10)]
+        public void ApplySupportState_ExposesSourceGroundedTenPercentModifier(
+            ActorCombatStateType stateType,
+            ActorAttributeType attributeType,
+            int expectedPercent)
+        {
+            object targetKey = new();
+            CombatantState caster = NewState(maxMp: 20);
+            CombatantState target = NewState();
+            SkillDefinition skill = CreateSupportSkill(
+                stateType,
+                CombatStateImpactType.Increase,
+                mpCost: 5);
+
+            SupportModifierSkillCastResolution<object> result =
+                SupportModifierSkillResolver<object>.Resolve(
+                    caster,
+                    SingleFirstPartySlot(targetKey, target),
+                    skill,
+                    targetKey);
+
+            Assert.That(target.HasCombatState(stateType), Is.True);
+            Assert.That(target.GetSupportModifierPercent(attributeType), Is.EqualTo(expectedPercent));
+            Assert.That(caster.CurrentMp, Is.EqualTo(15));
+            Assert.That(result.MpSpent, Is.EqualTo(5));
+            Assert.That(result.Targets[0].ModifierPercent, Is.EqualTo(expectedPercent));
+        }
+
+        [Test]
+        public void ApplySupportState_EmitsTypedCombatStateFact()
+        {
+            object targetKey = new();
+            CombatantState caster = NewState(maxMp: 10);
+            CombatantState target = NewState();
+            SkillDefinition skill = CreateSupportSkill(
+                ActorCombatStateType.DefenseIncrease,
+                CombatStateImpactType.Increase,
+                mpCost: 2);
+
+            SupportModifierSkillCastResolution<object> result =
+                SupportModifierSkillResolver<object>.Resolve(
+                    caster,
+                    SingleFirstPartySlot(targetKey, target),
+                    skill,
+                    targetKey);
+
+            CombatEvent targetEvent = result.Targets[0].Events[0];
+            Assert.That(result.CastEvents[0].Kind, Is.EqualTo(CombatEventKind.SkillCast));
+            Assert.That(targetEvent.Kind, Is.EqualTo(CombatEventKind.CombatStateChanged));
+            Assert.That(targetEvent.SkillId, Is.EqualTo(skill.Id));
+            Assert.That(targetEvent.CombatStateType, Is.EqualTo(ActorCombatStateType.DefenseIncrease));
+            Assert.That(targetEvent.CombatStateImpactType, Is.EqualTo(CombatStateImpactType.Increase));
+            Assert.That(targetEvent.Amount, Is.Zero);
+        }
+
+        [Test]
+        public void RemoveSupportState_ClearsPresenceAndReturnsNeutralModifier()
+        {
+            object targetKey = new();
+            CombatantState caster = NewState(maxMp: 10);
+            CombatantState target = NewState();
+            target.ApplyCombatState(ActorCombatStateType.AttackIncrease);
+            SkillDefinition skill = CreateSupportSkill(
+                ActorCombatStateType.AttackIncrease,
+                CombatStateImpactType.Remove,
+                mpCost: 3);
+
+            SupportModifierSkillCastResolution<object> result =
+                SupportModifierSkillResolver<object>.Resolve(
+                    caster,
+                    SingleFirstPartySlot(targetKey, target),
+                    skill,
+                    targetKey);
+
+            Assert.That(target.HasCombatState(ActorCombatStateType.AttackIncrease), Is.False);
+            Assert.That(target.GetSupportModifierPercent(ActorAttributeType.Attack), Is.Zero);
+            Assert.That(result.Targets[0].ModifierPercent, Is.Zero);
+            Assert.That(result.Targets[0].ImpactType, Is.EqualTo(CombatStateImpactType.Remove));
+            Assert.That(caster.CurrentMp, Is.EqualTo(7));
+        }
+
+        [Test]
+        public void PartyAll_AppliesInDeterministicFormationOrderAndSpendsMpOnce()
+        {
+            object casterKey = new();
+            object allyLateKey = new();
+            object allyEarlyKey = new();
+            CombatantState caster = NewState(maxMp: 30);
+            CombatantState allyLate = NewState();
+            CombatantState allyEarly = NewState();
+            SkillDefinition skill = CreateSupportSkill(
+                ActorCombatStateType.SpeedIncrease,
+                CombatStateImpactType.Increase,
+                mpCost: 8,
+                targetRange: TargetRangeType.FirstPartyAll);
+
+            CombatTargetSlot<object>[] slots =
+            {
+                new(allyLateKey, allyLate, CombatParty.First, row: 1, column: 0),
+                new(casterKey, caster, CombatParty.First, row: 0, column: 0),
+                new(allyEarlyKey, allyEarly, CombatParty.First, row: 0, column: 1),
+            };
+
+            SupportModifierSkillCastResolution<object> result =
+                SupportModifierSkillResolver<object>.Resolve(caster, slots, skill);
+
+            Assert.That(result.Targets[0].TargetKey, Is.SameAs(casterKey));
+            Assert.That(result.Targets[1].TargetKey, Is.SameAs(allyEarlyKey));
+            Assert.That(result.Targets[2].TargetKey, Is.SameAs(allyLateKey));
+            Assert.That(caster.CurrentMp, Is.EqualTo(22));
+            Assert.That(caster.GetSupportModifierPercent(ActorAttributeType.Speed), Is.EqualTo(10));
+            Assert.That(allyEarly.GetSupportModifierPercent(ActorAttributeType.Speed), Is.EqualTo(10));
+            Assert.That(allyLate.GetSupportModifierPercent(ActorAttributeType.Speed), Is.EqualTo(10));
+        }
+
