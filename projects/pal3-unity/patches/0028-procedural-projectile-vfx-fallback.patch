+++ b/Assets/Scripts/Pal3.Game/GameSystems/Combat/Presentation/ProceduralCombatVfx.cs
@@ -0,0 +1,40 @@
+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity open procedural combat VFX fallback. No third-party prefab pack is required.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.Combat.Presentation
+{
+    using Engine.Core.Abstraction;
+    using Engine.Core.Implementation;
+    using UnityEngine;
+
+    public static class ProceduralCombatVfx
+    {
+        public static IGameEntity CreateOrb(
+            string name,
+            IGameEntity parent,
+            float localScale,
+            Vector3? localOffset = null)
+        {
+            GameObject nativeObject = GameObject.CreatePrimitive(PrimitiveType.Sphere);
+            nativeObject.name = name;
+
+            Collider collider = nativeObject.GetComponent<Collider>();
+            if (collider != null)
+            {
+                Object.Destroy(collider);
+            }
+
+            Light light = nativeObject.AddComponent<Light>();
+            light.type = LightType.Point;
+            light.range = 2.5f;
+            light.intensity = 4f;
+
+            IGameEntity entity = new GameEntity(nativeObject);
+            entity.SetParent(parent, worldPositionStays: false);
+            entity.Transform.LocalPosition = localOffset ?? Vector3.zero;
+            entity.Transform.LocalScale = Vector3.one * localScale;
+            return entity;
+        }
+    }
+}
