@@ -0,0 +1,66 @@
+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity deterministic encounter outcome resolution.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Collections.Generic;
+    using System.Linq;
+
+    public enum CombatOutcomeStatus
+    {
+        InProgress = 0,
+        PlayerWin,
+        PlayerLose,
+        MutualDefeat,
+    }
+
+    public sealed class CombatOutcomeMember
+    {
+        public CombatParty Party { get; }
+        public CombatantState State { get; }
+
+        public CombatOutcomeMember(CombatParty party, CombatantState state)
+        {
+            Party = party;
+            State = state ?? throw new ArgumentNullException(nameof(state));
+        }
+    }
+
+    /// <summary>
+    /// Resolves encounter outcome from combat-domain HP truth only.
+    /// Presentation, input and script variables are deliberately excluded.
+    /// </summary>
+    public static class CombatOutcomeResolver
+    {
+        public static CombatOutcomeStatus Resolve(IEnumerable<CombatOutcomeMember> members)
+        {
+            if (members == null) throw new ArgumentNullException(nameof(members));
+
+            CombatOutcomeMember[] snapshot = members.ToArray();
+            bool hasPlayerParty = snapshot.Any(member => member.Party == CombatParty.First);
+            bool hasEnemyParty = snapshot.Any(member => member.Party == CombatParty.Enemy);
+
+            if (!hasPlayerParty || !hasEnemyParty)
+            {
+                throw new InvalidOperationException(
+                    "Combat outcome requires at least one member from each party.");
+            }
+
+            bool playerAlive = snapshot.Any(member =>
+                member.Party == CombatParty.First && member.State.IsAlive);
+            bool enemyAlive = snapshot.Any(member =>
+                member.Party == CombatParty.Enemy && member.State.IsAlive);
+
+            if (playerAlive && enemyAlive) return CombatOutcomeStatus.InProgress;
+            if (playerAlive) return CombatOutcomeStatus.PlayerWin;
+            if (enemyAlive) return CombatOutcomeStatus.PlayerLose;
+
+            // No current PAL3 mutation slice can defeat both parties in one atomic hit,
+            // but keeping this state explicit prevents a future effect from silently
+            // inventing win/lose semantics for simultaneous defeat.
+            return CombatOutcomeStatus.MutualDefeat;
+        }
+    }
+}

