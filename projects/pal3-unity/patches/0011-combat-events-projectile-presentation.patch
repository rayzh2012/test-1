+++ b/Assets/Scripts/Pal3.Game/GameSystems/Combat/Domain/CombatEvent.cs
@@ -0,0 +1,52 @@
+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity immutable combat-event facts.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.Combat.Domain
+{
+    using System;
+
+    public enum CombatEventKind
+    {
+        SkillCast = 0,
+        Damage,
+        TargetDefeated,
+    }
+
+    /// <summary>
+    /// Immutable fact emitted after domain resolution. Presentation may consume these facts,
+    /// but it cannot use them to mutate combat truth.
+    /// </summary>
+    public readonly struct CombatEvent
+    {
+        public CombatEventKind Kind { get; }
+        public uint SkillId { get; }
+        public int Amount { get; }
+
+        private CombatEvent(CombatEventKind kind, uint skillId, int amount)
+        {
+            if (skillId == 0) throw new ArgumentOutOfRangeException(nameof(skillId));
+            if (amount < 0) throw new ArgumentOutOfRangeException(nameof(amount));
+
+            Kind = kind;
+            SkillId = skillId;
+            Amount = amount;
+        }
+
+        public static CombatEvent ForSkillCast(uint skillId)
+        {
+            return new CombatEvent(CombatEventKind.SkillCast, skillId, amount: 0);
+        }
+
+        public static CombatEvent ForDamage(uint skillId, int damage)
+        {
+            if (damage <= 0) throw new ArgumentOutOfRangeException(nameof(damage));
+            return new CombatEvent(CombatEventKind.Damage, skillId, damage);
+        }
+
+        public static CombatEvent ForTargetDefeated(uint skillId)
+        {
+            return new CombatEvent(CombatEventKind.TargetDefeated, skillId, amount: 0);
+        }
+    }
+}
