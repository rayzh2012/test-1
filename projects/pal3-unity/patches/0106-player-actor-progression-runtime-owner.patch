+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity runtime owner for persistent player progression snapshots.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.PlayerProgression
+{
+    using System;
+    using System.Collections.Generic;
+    using Command.Extensions;
+    using Core.Command;
+    using Core.Contract.Constants;
+    using Core.Contract.Enums;
+    using Core.DataReader.Gdb;
+    using Core.Utilities;
+    using Data;
+    using Domain;
+
+    public sealed class PlayerActorProgressionManager : IDisposable,
+        ICommandExecutor<ResetGameStateCommand>
+    {
+        private readonly PlayerActorProgressionStore _store;
+
+        public PlayerActorProgressionManager(GameResourceProvider resourceProvider)
+        {
+            Requires.IsNotNull(resourceProvider, nameof(resourceProvider));
+
+            IDictionary<int, CombatActorInfo> combatActorInfos =
+                resourceProvider.GetCombatActorInfos();
+            Dictionary<PlayerActorId, CombatActorInfo> baselines = new();
+
+            foreach ((PlayerActorId actorId, int combatActorId)
+                     in ActorConstants.MainActorCombatActorIdMap)
+            {
+                if (!combatActorInfos.TryGetValue(combatActorId, out CombatActorInfo actorInfo))
+                {
+                    throw new KeyNotFoundException(
+                        $"Missing main-actor combat baseline [{combatActorId}] for [{actorId}].");
+                }
+
+                baselines[actorId] = actorInfo;
+            }
+
+            _store = new PlayerActorProgressionStore(baselines);
+            CommandExecutorRegistry<ICommand>.Instance.Register(this);
+        }
+
+        public void Dispose()
+        {
+            CommandExecutorRegistry<ICommand>.Instance.UnRegister(this);
+        }
+
+        public PlayerActorProgressionSnapshot GetSnapshot(PlayerActorId actorId)
+        {
+            return _store.GetSnapshot(actorId);
+        }
+
+        public void RestoreSnapshot(PlayerActorProgressionSnapshot snapshot)
+        {
+            _store.RestoreSnapshot(snapshot);
+        }
+
+        public CombatActorInfo BuildCombatActorInfo(PlayerActorId actorId)
+        {
+            return _store.BuildCombatActorInfo(actorId);
+        }
+
+        public void Execute(ResetGameStateCommand command)
+        {
+            _store.Reset();
+        }
+    }
+}
