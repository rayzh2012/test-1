+        private void TryFinishCombatFromRuntimeState()
+        {
+            if (_combatFinishSignaled) return;
+
+            List<CombatOutcomeMember> members = new();
+            foreach (CombatActorController controller in _runtimeCombatStates.Keys)
+            {
+                members.Add(new CombatOutcomeMember(
+                    _runtimeCombatParties[controller],
+                    _runtimeCombatStates.Get(controller)));
+            }
+
+            CombatOutcomeStatus outcome = CombatOutcomeResolver.Resolve(members);
+            switch (outcome)
+            {
+                case CombatOutcomeStatus.PlayerWin:
+                    SignalCombatFinished(isPlayerWin: true);
+                    break;
+                case CombatOutcomeStatus.PlayerLose:
+                    SignalCombatFinished(isPlayerWin: false);
+                    break;
+                case CombatOutcomeStatus.MutualDefeat:
+                    EngineLogger.LogWarning(
+                        "Combat reached mutual defeat; no PAL3 tie semantics are locked yet.");
+                    break;
+            }
+        }
+
+        private void SignalCombatFinished(bool isPlayerWin)
+        {
+            if (_combatFinishSignaled) return;
+            _combatFinishSignaled = true;
+
+            OnCombatFinished?.Invoke(this, new CombatResult
+            {
+                IsPlayerWin = isPlayerWin,
+                CombatContext = _currentCombatContext,
+            });
         }
 
