+namespace Pal3.Game.Tests.GameSystems.PlayerProgression.Domain
+{
+    using System.Collections.Generic;
+    using NUnit.Framework;
+    using Pal3.Core.Contract.Enums;
+    using Pal3.Core.DataReader.Gdb;
+    using Pal3.Game.GameSystems.PlayerProgression.Domain;
+
+    public sealed class PlayerActorProgressionStoreTests
+    {
+        [Test]
+        public void Constructor_SeedsSnapshotFromStaticGdbBaseline()
+        {
+            PlayerActorProgressionStore store = CreateStore();
+
+            PlayerActorProgressionSnapshot snapshot =
+                store.GetSnapshot(PlayerActorId.JingTian);
+
+            Assert.That(snapshot.Level, Is.EqualTo(5));
+            Assert.That(snapshot.Experience, Is.EqualTo(123));
+            Assert.That(snapshot.AttributeValues[ActorAttributeType.Hp], Is.EqualTo(500));
+            Assert.That(snapshot.ElementAttributeValues[ElementType.Wind], Is.EqualTo(6));
+        }
+
+        [Test]
+        public void Snapshot_DefensivelyCopiesProgressionDictionaries()
+        {
+            Dictionary<ActorAttributeType, int> attributes = new()
+            {
+                [ActorAttributeType.Hp] = 500,
+            };
+            Dictionary<ElementType, int> elements = new()
+            {
+                [ElementType.Wind] = 6,
+            };
+            PlayerActorProgressionSnapshot snapshot = new(
+                PlayerActorId.JingTian, 5, 123, attributes, elements);
+
+            attributes[ActorAttributeType.Hp] = 1;
+            elements[ElementType.Wind] = 1;
+
+            Assert.That(snapshot.AttributeValues[ActorAttributeType.Hp], Is.EqualTo(500));
+            Assert.That(snapshot.ElementAttributeValues[ElementType.Wind], Is.EqualTo(6));
+        }
+
+        [Test]
+        public void RestoreSnapshot_ChangesOnlyRequestedActor()
+        {
+            PlayerActorProgressionStore store = CreateStore();
+            PlayerActorProgressionSnapshot jingTian = store.GetSnapshot(PlayerActorId.JingTian);
+            PlayerActorProgressionSnapshot xueJianBefore = store.GetSnapshot(PlayerActorId.XueJian);
+
+            store.RestoreSnapshot(new PlayerActorProgressionSnapshot(
+                PlayerActorId.JingTian,
+                9,
+                999,
+                new Dictionary<ActorAttributeType, int>(jingTian.AttributeValues)
+                {
+                    [ActorAttributeType.Hp] = 900,
+                },
+                new Dictionary<ElementType, int>(jingTian.ElementAttributeValues)));
+
+            Assert.That(store.GetSnapshot(PlayerActorId.JingTian).Level, Is.EqualTo(9));
+            Assert.That(store.GetSnapshot(PlayerActorId.JingTian).Experience, Is.EqualTo(999));
+            Assert.That(
+                store.GetSnapshot(PlayerActorId.JingTian).AttributeValues[ActorAttributeType.Hp],
+                Is.EqualTo(900));
+            Assert.That(store.GetSnapshot(PlayerActorId.XueJian).Level, Is.EqualTo(xueJianBefore.Level));
+            Assert.That(
+                store.GetSnapshot(PlayerActorId.XueJian).Experience,
+                Is.EqualTo(xueJianBefore.Experience));
+        }
+
+        [Test]
+        public void BuildCombatActorInfo_OverlaysPersistentProgressionWithoutMutatingBaseline()
+        {
+            PlayerActorProgressionStore store = CreateStore();
+            PlayerActorProgressionSnapshot baseline = store.GetSnapshot(PlayerActorId.JingTian);
+
+            store.RestoreSnapshot(new PlayerActorProgressionSnapshot(
+                PlayerActorId.JingTian,
+                8,
+                1012,
+                new Dictionary<ActorAttributeType, int>(baseline.AttributeValues)
+                {
+                    [ActorAttributeType.Hp] = 777,
+                },
+                new Dictionary<ElementType, int>(baseline.ElementAttributeValues)));
+
+            CombatActorInfo combatInfo = store.BuildCombatActorInfo(PlayerActorId.JingTian);
+            combatInfo.AttributeValues[ActorAttributeType.Hp] = 1;
+
+            Assert.That(combatInfo.Level, Is.EqualTo(8));
+            Assert.That(combatInfo.Experience, Is.EqualTo(1012));
+            Assert.That(store.GetSnapshot(PlayerActorId.JingTian).AttributeValues[ActorAttributeType.Hp],
+                Is.EqualTo(777));
+        }
+
+        [Test]
+        public void Reset_RestoresOriginalGdbBaseline()
+        {
+            PlayerActorProgressionStore store = CreateStore();
+            PlayerActorProgressionSnapshot baseline = store.GetSnapshot(PlayerActorId.JingTian);
+
+            store.RestoreSnapshot(new PlayerActorProgressionSnapshot(
+                PlayerActorId.JingTian,
+                30,
+                123456,
+                new Dictionary<ActorAttributeType, int>(baseline.AttributeValues),
+                new Dictionary<ElementType, int>(baseline.ElementAttributeValues)));
+            store.Reset();
+
+            PlayerActorProgressionSnapshot restored = store.GetSnapshot(PlayerActorId.JingTian);
+            Assert.That(restored.Level, Is.EqualTo(5));
+            Assert.That(restored.Experience, Is.EqualTo(123));
+        }
+
+        [Test]
+        public void Constructor_ClonesStaticGdbReferenceFields()
+        {
+            CombatActorInfo source = CreateCombatActorInfo(101, 5, 123, 500, 6);
+            Dictionary<PlayerActorId, CombatActorInfo> baselines = new()
+            {
+                [PlayerActorId.JingTian] = source,
+            };
+
+            PlayerActorProgressionStore store = new(baselines);
+            source.AttributeValues[ActorAttributeType.Hp] = 1;
+            source.ElementAttributeValues[ElementType.Wind] = 1;
+
+            PlayerActorProgressionSnapshot snapshot = store.GetSnapshot(PlayerActorId.JingTian);
+            Assert.That(snapshot.AttributeValues[ActorAttributeType.Hp], Is.EqualTo(500));
+            Assert.That(snapshot.ElementAttributeValues[ElementType.Wind], Is.EqualTo(6));
+        }
+
+        private static PlayerActorProgressionStore CreateStore()
+        {
+            return new PlayerActorProgressionStore(new Dictionary<PlayerActorId, CombatActorInfo>
+            {
+                [PlayerActorId.JingTian] = CreateCombatActorInfo(101, 5, 123, 500, 6),
+                [PlayerActorId.XueJian] = CreateCombatActorInfo(104, 4, 88, 420, 2),
+            });
+        }
+
+        private static CombatActorInfo CreateCombatActorInfo(
+            uint id,
+            int level,
+            int experience,
+            int hp,
+            int wind)
+        {
+            return new CombatActorInfo
+            {
+                Id = id,
+                Type = CombatActorType.MainActor,
+                Name = $"Actor_{id}",
+                Level = level,
+                Experience = experience,
+                AttributeValues = new Dictionary<ActorAttributeType, int>
+                {
+                    [ActorAttributeType.Hp] = hp,
+                    [ActorAttributeType.Sp] = 100,
+                    [ActorAttributeType.Mp] = 80,
+                },
+                ElementAttributeValues = new Dictionary<ElementType, int>
+                {
+                    [ElementType.Water] = 1,
+                    [ElementType.Fire] = 2,
+                    [ElementType.Wind] = wind,
+                    [ElementType.Thunder] = 3,
+                    [ElementType.Earth] = 4,
+                },
+                CombatStateImpactTypes = new Dictionary<ActorCombatStateType, CombatStateImpactType>(),
+                MainActorFavor = new ushort[6],
+                SkillIds = new uint[4],
+                SkillLevels = new byte[4],
+                Properties = new float[10],
+            };
+        }
+    }
+}
