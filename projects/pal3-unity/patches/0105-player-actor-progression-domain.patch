+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity persistent per-player progression state.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.PlayerProgression.Domain
+{
+    using System;
+    using System.Collections.Generic;
+    using System.Collections.ObjectModel;
+    using Core.Contract.Enums;
+    using Core.DataReader.Gdb;
+
+    public sealed class PlayerActorProgressionSnapshot
+    {
+        private readonly IReadOnlyDictionary<ActorAttributeType, int> _attributeValues;
+        private readonly IReadOnlyDictionary<ElementType, int> _elementAttributeValues;
+
+        public PlayerActorId ActorId { get; }
+        public int Level { get; }
+        public int Experience { get; }
+        public IReadOnlyDictionary<ActorAttributeType, int> AttributeValues => _attributeValues;
+        public IReadOnlyDictionary<ElementType, int> ElementAttributeValues => _elementAttributeValues;
+
+        public PlayerActorProgressionSnapshot(
+            PlayerActorId actorId,
+            int level,
+            int experience,
+            IDictionary<ActorAttributeType, int> attributeValues,
+            IDictionary<ElementType, int> elementAttributeValues)
+        {
+            if (attributeValues == null) throw new ArgumentNullException(nameof(attributeValues));
+            if (elementAttributeValues == null) throw new ArgumentNullException(nameof(elementAttributeValues));
+
+            ActorId = actorId;
+            Level = level;
+            Experience = experience;
+            _attributeValues = new ReadOnlyDictionary<ActorAttributeType, int>(
+                new Dictionary<ActorAttributeType, int>(attributeValues));
+            _elementAttributeValues = new ReadOnlyDictionary<ElementType, int>(
+                new Dictionary<ElementType, int>(elementAttributeValues));
+        }
+
+        public PlayerActorProgressionSnapshot Copy()
+        {
+            return new PlayerActorProgressionSnapshot(
+                ActorId,
+                Level,
+                Experience,
+                new Dictionary<ActorAttributeType, int>(_attributeValues),
+                new Dictionary<ElementType, int>(_elementAttributeValues));
+        }
+    }
+
+    public sealed class PlayerActorProgressionStore
+    {
+        private readonly Dictionary<PlayerActorId, CombatActorInfo> _baselines = new();
+        private readonly Dictionary<PlayerActorId, PlayerActorProgressionSnapshot> _snapshots = new();
+
+        public PlayerActorProgressionStore(IDictionary<PlayerActorId, CombatActorInfo> baselines)
+        {
+            if (baselines == null) throw new ArgumentNullException(nameof(baselines));
+
+            foreach ((PlayerActorId actorId, CombatActorInfo actorInfo) in baselines)
+            {
+                CombatActorInfo baseline = CloneCombatActorInfo(actorInfo);
+                _baselines[actorId] = baseline;
+                _snapshots[actorId] = CreateSnapshot(actorId, baseline);
+            }
+        }
+
+        public PlayerActorProgressionSnapshot GetSnapshot(PlayerActorId actorId)
+        {
+            if (!_snapshots.TryGetValue(actorId, out PlayerActorProgressionSnapshot snapshot))
+            {
+                throw new KeyNotFoundException($"No progression baseline registered for actor [{actorId}].");
+            }
+
+            return snapshot.Copy();
+        }
+
+        public void RestoreSnapshot(PlayerActorProgressionSnapshot snapshot)
+        {
+            if (snapshot == null) throw new ArgumentNullException(nameof(snapshot));
+            if (!_baselines.ContainsKey(snapshot.ActorId))
+            {
+                throw new KeyNotFoundException(
+                    $"No progression baseline registered for actor [{snapshot.ActorId}].");
+            }
+
+            _snapshots[snapshot.ActorId] = snapshot.Copy();
+        }
+
+        public void Reset()
+        {
+            _snapshots.Clear();
+            foreach ((PlayerActorId actorId, CombatActorInfo baseline) in _baselines)
+            {
+                _snapshots[actorId] = CreateSnapshot(actorId, baseline);
+            }
+        }
+
+        public CombatActorInfo BuildCombatActorInfo(PlayerActorId actorId)
+        {
+            if (!_baselines.TryGetValue(actorId, out CombatActorInfo baseline))
+            {
+                throw new KeyNotFoundException($"No progression baseline registered for actor [{actorId}].");
+            }
+
+            PlayerActorProgressionSnapshot snapshot = _snapshots[actorId];
+            CombatActorInfo result = CloneCombatActorInfo(baseline);
+            result.Level = snapshot.Level;
+            result.Experience = snapshot.Experience;
+            result.AttributeValues =
+                new Dictionary<ActorAttributeType, int>(snapshot.AttributeValues);
+            result.ElementAttributeValues =
+                new Dictionary<ElementType, int>(snapshot.ElementAttributeValues);
+            return result;
+        }
+
+        private static PlayerActorProgressionSnapshot CreateSnapshot(
+            PlayerActorId actorId,
+            CombatActorInfo actorInfo)
+        {
+            return new PlayerActorProgressionSnapshot(
+                actorId,
+                actorInfo.Level,
+                actorInfo.Experience,
+                actorInfo.AttributeValues ?? new Dictionary<ActorAttributeType, int>(),
+                actorInfo.ElementAttributeValues ?? new Dictionary<ElementType, int>());
+        }
+
+        private static CombatActorInfo CloneCombatActorInfo(CombatActorInfo source)
+        {
+            CombatActorInfo clone = source;
+            clone.ElementAttributeValues = source.ElementAttributeValues == null
+                ? null
+                : new Dictionary<ElementType, int>(source.ElementAttributeValues);
+            clone.AttributeValues = source.AttributeValues == null
+                ? null
+                : new Dictionary<ActorAttributeType, int>(source.AttributeValues);
+            clone.CombatStateImpactTypes = source.CombatStateImpactTypes == null
+                ? null
+                : new Dictionary<ActorCombatStateType, CombatStateImpactType>(
+                    source.CombatStateImpactTypes);
+            clone.MainActorFavor = source.MainActorFavor == null
+                ? null
+                : (ushort[])source.MainActorFavor.Clone();
+            clone.SkillIds = source.SkillIds == null ? null : (uint[])source.SkillIds.Clone();
+            clone.SkillLevels = source.SkillLevels == null ? null : (byte[])source.SkillLevels.Clone();
+            clone.Properties = source.Properties == null ? null : (float[])source.Properties.Clone();
+            return clone;
+        }
+    }
+}

