+namespace Pal3.Game.Tests.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Collections.Generic;
+    using NUnit.Framework;
+    using Pal3.Game.GameSystems.Combat.Domain;
+
+    public sealed class CombatRewardResolverTests
+    {
+        [Test]
+        public void Resolve_SumsMoneyExperienceAndAggregatesLoot()
+        {
+            CombatRewardSummary reward = CombatRewardResolver.Resolve(new[]
+            {
+                new CombatRewardSource(10, 3, 101, 1),
+                new CombatRewardSource(20, 7, 101, 2),
+                new CombatRewardSource(5, 0, 202, 4),
+            });
+
+            Assert.That(reward.Experience, Is.EqualTo(35));
+            Assert.That(reward.Money, Is.EqualTo(10));
+            Assert.That(reward.Items[101], Is.EqualTo(3));
+            Assert.That(reward.Items[202], Is.EqualTo(4));
+        }
+
+        [Test]
+        public void Resolve_EmptySources_ReturnsEmptyReward()
+        {
+            CombatRewardSummary reward =
+                CombatRewardResolver.Resolve(Array.Empty<CombatRewardSource>());
+
+            Assert.That(reward.Experience, Is.Zero);
+            Assert.That(reward.Money, Is.Zero);
+            Assert.That(reward.Items, Is.Empty);
+        }
+
+        [TestCase(-1, 0, 0u, 0)]
+        [TestCase(0, -1, 0u, 0)]
+        [TestCase(0, 0, 0u, -1)]
+        public void Source_RejectsNegativeRewardValues(
+            int experience, int money, uint lootItemId, int lootCount)
+        {
+            Assert.Throws<ArgumentOutOfRangeException>(() =>
+                new CombatRewardSource(experience, money, lootItemId, lootCount));
+        }
+
+        [TestCase(0u, 1)]
+        [TestCase(101u, 0)]
+        public void Source_RejectsInconsistentLootTuple(uint lootItemId, int lootCount)
+        {
+            Assert.Throws<ArgumentException>(() =>
+                new CombatRewardSource(0, 0, lootItemId, lootCount));
+        }
+
+        [Test]
+        public void Resolve_UsesCheckedArithmetic()
+        {
+            Assert.Throws<OverflowException>(() =>
+                CombatRewardResolver.Resolve(new[]
+                {
+                    new CombatRewardSource(int.MaxValue, int.MaxValue),
+                    new CombatRewardSource(1, 1),
+                }));
+        }
+
+        [Test]
+        public void Summary_DefensivelyCopiesItems()
+        {
+            Dictionary<uint, int> items = new() { [101] = 2 };
+            CombatRewardSummary reward = new(1, 2, items);
+            items[101] = 99;
+
+            Assert.That(reward.Items[101], Is.EqualTo(2));
+        }
+    }
+}
