diff --git a/Assets/Scripts/Pal3.Game/GameSystems/Combat/Domain/CombatRewardResolver.cs b/Assets/Scripts/Pal3.Game/GameSystems/Combat/Domain/CombatRewardResolver.cs
new file mode 100644
--- /dev/null
+++ b/Assets/Scripts/Pal3.Game/GameSystems/Combat/Domain/CombatRewardResolver.cs
@@ -0,0 +1,95 @@
+// ---------------------------------------------------------------------------------------------
+//  PAL3.Unity deterministic combat reward aggregation.
+// ---------------------------------------------------------------------------------------------
+
+namespace Pal3.Game.GameSystems.Combat.Domain
+{
+    using System;
+    using System.Collections.Generic;
+    using System.Collections.ObjectModel;
+    using System.Linq;
+
+    public sealed class CombatRewardSource
+    {
+        public int Experience { get; }
+        public int Money { get; }
+        public uint LootItemId { get; }
+        public int LootCount { get; }
+
+        public CombatRewardSource(int experience, int money, uint lootItemId = 0, int lootCount = 0)
+        {
+            if (experience < 0) throw new ArgumentOutOfRangeException(nameof(experience));
+            if (money < 0) throw new ArgumentOutOfRangeException(nameof(money));
+            if (lootCount < 0) throw new ArgumentOutOfRangeException(nameof(lootCount));
+
+            if ((lootItemId == 0) != (lootCount == 0))
+            {
+                throw new ArgumentException(
+                    "Loot item id and loot count must either both be zero or both be non-zero.");
+            }
+
+            Experience = experience;
+            Money = money;
+            LootItemId = lootItemId;
+            LootCount = lootCount;
+        }
+    }
+
+    public sealed class CombatRewardSummary
+    {
+        private readonly IReadOnlyDictionary<uint, int> _items;
+
+        public int Experience { get; }
+        public int Money { get; }
+        public IReadOnlyDictionary<uint, int> Items => _items;
+
+        public static CombatRewardSummary Empty { get; } =
+            new(0, 0, new Dictionary<uint, int>());
+
+        public CombatRewardSummary(int experience, int money, IDictionary<uint, int> items)
+        {
+            if (experience < 0) throw new ArgumentOutOfRangeException(nameof(experience));
+            if (money < 0) throw new ArgumentOutOfRangeException(nameof(money));
+            if (items == null) throw new ArgumentNullException(nameof(items));
+            if (items.Any(item => item.Key == 0 || item.Value <= 0))
+            {
+                throw new ArgumentException(
+                    "Reward items require non-zero ids and positive counts.",
+                    nameof(items));
+            }
+
+            Experience = experience;
+            Money = money;
+            _items = new ReadOnlyDictionary<uint, int>(new Dictionary<uint, int>(items));
+        }
+    }
+
+    public static class CombatRewardResolver
+    {
+        public static CombatRewardSummary Resolve(IEnumerable<CombatRewardSource> sources)
+        {
+            if (sources == null) throw new ArgumentNullException(nameof(sources));
+
+            int experience = 0;
+            int money = 0;
+            Dictionary<uint, int> items = new();
+
+            foreach (CombatRewardSource source in sources)
+            {
+                if (source == null)
+                {
+                    throw new ArgumentException("Reward sources cannot contain null entries.", nameof(sources));
+                }
+
+                experience = checked(experience + source.Experience);
+                money = checked(money + source.Money);
+                if (source.LootItemId == 0) continue;
+
+                items[source.LootItemId] =
+                    checked(items.GetValueOrDefault(source.LootItemId) + source.LootCount);
+            }
+
+            return new CombatRewardSummary(experience, money, items);
+        }
+    }
+}

